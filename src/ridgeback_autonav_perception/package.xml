<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ridgeback_autonav_perception</name>
  <version>0.1.0</version>
  <description>Room-sign perception: YOLO detector + PARSeq recognizer + depth-to-map projection.</description>
  <maintainer email="mnlmmnt@gmail.com">mqi</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>cv_bridge</exec_depend>
  <exec_depend>message_filters</exec_depend>
  <exec_depend>tf2_ros</exec_depend>
  <exec_depend>tf2_geometry_msgs</exec_depend>
  <exec_depend>ridgeback_autonav_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <!-- camera_publisher uses pyrealsense2 (librealsense Python API), already
       present on this Jetson. Not a rosdep key, so no <depend> entry. -->

  <test_depend>ament_copyright</test_depend>
  <test_depend>ament_flake8</test_depend>
  <test_depend>ament_pep257</test_depend>
  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
